# Copia este archivo como .env y completa tus claves. NUNCA subas .env a GitHub.

# --- Conexión con JARVIS (las mismas claves que pusiste en Vercel)
JARVIS_URL=https://jarvis-mane.vercel.app
WORKER_SECRET=
TELEGRAM_TOKEN=
# Segundos entre consultas a JARVIS
PUENTE_INTERVALO_SEG=20
# Opcional: ruta completa a Claude Code si "claude" no está en el PATH
CLAUDE_CMD=

# --- Producción
# gratis = clips de stock + voz Kokoro (0 USD). economico / premium = video generado (de pago)
MODO_PRODUCCION=gratis
# pixabay (llave gratis en pixabay.com/api/docs tras crear cuenta) | pexels
STOCK_PROVEEDOR=pixabay
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Voz
# chatterbox (más natural, GPU, MIT; si falla usa kokoro) | kokoro (Apache-2.0) | elevenlabs (de pago)
VOZ_MOTOR=chatterbox
# Chatterbox: expresividad (0.3-1.0) y ritmo (cfg más bajo = más pausado). Valores para narración de misterio.
CHATTERBOX_EXAGERACION=0.6
CHATTERBOX_CFG=0.4
# Opcional: clip WAV de ~10 s de la voz a imitar, en el mismo idioma (tu voz o una de licencia libre)
CHATTERBOX_VOZ_ES=assets/voces/narrador_es.wav
CHATTERBOX_VOZ_EN=
KOKORO_VOZ_ES=em_alex
KOKORO_VOZ_EN=am_michael
KOKORO_VOZ_PT=pm_alex
KOKORO_VELOCIDAD=1.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2
ELEVENLABS_USD_POR_1K_CARACTERES=0.30

# --- Kling (solo modos de pago)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_MODELO=kling-v2-6
KLING_MODO=std
KLING_CONCURRENCIA=3
KLING_USD_POR_SEG=0.07

# --- Presupuesto por video (modos de pago)
PRESUPUESTO_MAX_USD=3
MARGEN_REINTENTOS=1.3

# --- Ensamblado
# Música respecto a la voz cuando no hay narración, en dB (más negativo = más suave). Bajo la voz baja ~4 dB más.
MUSICA_DB_BAJO_VOZ=-12
# Subtítulos: whisper (tiempos reales escuchando el audio) | estimado
SUBTITULOS_SINCRONIA=whisper
WHISPER_MODELO=base
# Clips de stock por escena (2 = un corte cada 2-3 s)
CLIPS_POR_ESCENA=2

# --- YouTube
YOUTUBE_CLIENT_SECRET=credenciales/client_secret.json
YOUTUBE_TOKEN=credenciales/token.json
# Déjalo en 0: tú publicas desde YouTube Studio
PERMITIR_PUBLICO=0
